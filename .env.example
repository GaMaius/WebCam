# Backblaze B2 (S3-compatible) — used to store raw session recordings.
# Create a bucket + an Application Key scoped to it, then fill these in.
# Never commit the real values — copy this file to .env.local instead.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-bucket-name
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key

# Groq — PokéMatch's ranking judge (/api/pokematch/judge).
# Without this the app still works: it silently falls back to the local
# z-score ranking and shows a notice instead of the AI's picks.
GROQ_API_KEY=your-groq-api-key
# Optional. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b
